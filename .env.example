# Default: OpenRouter decisions endpoint with OPENROUTER_API_KEY.
# Official TypeSafe API: set only TYPESAFE_API_KEY.
# Any other provider: set JEV_API_KEY (+ JEV_BASE_URL if it is not
# OpenRouter-compatible), e.g. a local adapter on 127.0.0.1.
OPENROUTER_API_KEY=
#JEV_API_KEY=
#JEV_BASE_URL=
#TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
